rules_version = '2';

// Zing security rules.
//
// These rules ARE the backend authorization layer: browsers talk straight to
// Firestore, so anything not forbidden here is public. Message bodies are
// end-to-end encrypted on-device, so even a rules mistake leaks ciphertext
// only -- but metadata still deserves protecting.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // True when the caller and `uid` have a chat in which BOTH have sent a
    // message. Merely opening a chat with someone whose @username you know is
    // not enough -- they have to have answered. Chat ids are the two uids
    // sorted and joined (enforced on create), so this is one lookup.
    //
    // And `uid` has not blocked the caller: someone you block loses your
    // number and your contacts-only photo with it.
    function hasConversationWith(uid) {
      let me = request.auth.uid;
      let chatId = me < uid ? me + '_' + uid : uid + '_' + me;
      let path = /databases/$(database)/documents/chats/$(chatId);
      return signedIn()
             && exists(path)
             && get(path).data.get('sent', {}).get(me, false) == true
             && get(path).data.get('sent', {}).get(uid, false) == true
             && get(path).data.get('blocked', {}).get(uid, false) != true;
    }

    // Ceiling on one message's ciphertext, in characters of base64. Keeps one
    // huge message from eating storage and every reader's bandwidth. The app
    // stops at 4,000 characters (MAX_MESSAGE_LENGTH in lib/db/schema.ts), which
    // seals to ~16,000 at worst.
    function MAX_CIPHERTEXT() {
      return 22000;
    }

    function chatMembers(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // Either member has blocked the other. Same doc as chatMembers(), and
    // repeat get()s of one doc are billed once per request, so this is free.
    function chatBlocked(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.get('blocked', {}).size() > 0;
    }

    // Profiles are readable one at a time by any signed-in user: @username
    // search and public key lookup both need it. keyBackup lives here too and
    // is safe to expose -- it is an Argon2id-wrapped blob, useless without the
    // passphrase. Listing is off: nobody needs to enumerate every user.
    //
    // Nothing private may live on this doc. The field allowlists below are what
    // keep it that way; push tokens go in private/account, the phone number in
    // shared/contact.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;

      // The profile and its username claim must land in the same transaction:
      // getAfter() sees the claim only if it is written alongside, and it must
      // name this user. Without this, a hand-rolled client could skip the claim
      // and put someone else's @handle on its own profile.
      allow create: if isSelf(uid)
                    && request.resource.data.keys().hasOnly([
                         'uid', 'username', 'displayName', 'photoURL', 'about',
                         'publicKey', 'keyBackup', 'createdAt'])
                    && request.resource.data.uid == uid
                    && request.resource.data.username is string
                    && request.resource.data.publicKey is string
                    && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;

      // Username and public key are identity anchors -- neither may drift after
      // creation, or safety numbers and @handles stop meaning anything. Only
      // these fields may change at all. contactPhoto says the photo is at
      // shared/photo, for contacts only (lib/db/privacy.ts).
      allow update: if isSelf(uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'about', 'photoURL', 'keyBackup', 'contactPhoto'])
                    && request.resource.data.get('contactPhoto', true) == true;

      // "Delete my account" (lib/db/account.ts). Chats and the messages in
      // them stay: they belong to the other person too.
      allow delete: if isSelf(uid);

      // Owner-only: push tokens and the recovery-key backup. The push route
      // reads this with admin credentials, which bypass rules.
      match /private/{docId} {
        allow read, write: if isSelf(uid);
      }

      // The phone number and a contacts-only photo: shown to someone you have
      // actually talked with -- both of you have sent a message, and you have
      // not blocked them -- never to arbitrary signed-in users.
      //
      // The contact doc may show only a number its owner has claimed, so
      // nobody can display a number that belongs to someone else. getAfter()
      // sees a claim written in the same transaction.
      match /shared/{docId} {
        allow read: if isSelf(uid) || hasConversationWith(uid);
        allow delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
                              && docId in ['contact', 'photo']
                              && (docId != 'contact'
                                  || request.resource.data.get('phone', null) == null
                                  || (request.resource.data.phone is string
                                      && request.resource.data.phone.matches('^[+][1-9][0-9]{6,14}$')
                                      && getAfter(/databases/$(database)/documents/phones/$(request.resource.data.phone)).data.uid == uid))
                              && (docId != 'photo'
                                  || (request.resource.data.keys().hasOnly(['photoURL'])
                                      && request.resource.data.photoURL is string
                                      && request.resource.data.photoURL.size() <= 2048));
      }
    }

    // Username claims. Never updated, so a claim can never be stolen or
    // reassigned. Each claim must be matched by the claimant's own profile in
    // the same transaction, so one account cannot squat a pile of handles.
    // The owner releases it only when deleting their account, together with
    // the profile itself.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && username.matches('^[a-z0-9_]{3,20}$')
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow delete: if signedIn()
                    && resource.data.uid == request.auth.uid
                    && !existsAfter(/databases/$(database)/documents/users/$(request.auth.uid));
      allow update: if false;
    }

    // Phone number claims, for "find by phone". get works for someone who
    // already knows the number; list does not, so the set cannot be dumped.
    // A claim must match the number in the claimant's own contact doc, so each
    // account holds at most one. Ids are E.164 (+233241234567), the one form
    // lib/phone.ts writes, so a number cannot be claimed twice under two
    // spellings.
    match /phones/{phone} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && phone.matches('^[+][1-9][0-9]{6,14}$')
                    && request.resource.data.uid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/shared/contact).data.phone == phone;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /chats/{chatId} {

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      // `list` is safe because the only query the app issues is constrained by
      // array-contains on the caller's own uid.
      allow list: if isMember();

      // ensureDirectChat reads the doc before creating it, so a get must also
      // succeed when nothing is there yet -- resource is null then, and
      // isMember() alone would deny. Chat ids are the two uids sorted and
      // joined, so only the two people it would belong to may probe for it.
      allow get: if isMember()
                 || (signedIn() && resource == null && request.auth.uid in chatId.split('_'));

      // The id must be the members' sorted uids, so a pair can never get a
      // second conversation under some other id.
      //
      // And a new chat starts empty. Everything else on the doc is guarded on
      // update; without this a hand-rolled client could create a chat already
      // claiming both people have spoken (unlocking a stranger's phone
      // number), or with forged receipts, a huge badge or an oversized preview.
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2
                    && request.resource.data.members[0] < request.resource.data.members[1]
                    && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1]
                    && request.resource.data.keys().hasOnly([
                         'members', 'lastMessage', 'lastRead', 'lastDelivered', 'unread',
                         'createdAt', 'updatedAt'])
                    && request.resource.data.get('lastMessage', null) == null
                    && request.resource.data.get('lastRead', {}) == {}
                    && request.resource.data.get('lastDelivered', {}) == {}
                    && request.resource.data.get('unread', {}) == {};

      // A member may write only their own receipt, and only as "now" -- the app
      // always writes serverTimestamp(). Without this either member could mark
      // the other as having read or received messages they never saw.
      function ownReceiptOnly(field) {
        let before = resource.data.get(field, {});
        let after = request.resource.data.get(field, {});
        let changed = after.diff(before).affectedKeys();
        return changed.size() == 0
               || (changed.hasOnly([request.auth.uid]) && after[request.auth.uid] == request.time);
      }

      // Unread badges: I may clear my own count, or add exactly one to the
      // other member's when I send. Nothing else -- no inflating someone's
      // badge by a thousand, no zeroing it for them.
      function unreadChangeOk() {
        let me = request.auth.uid;
        let peer = resource.data.members[0] == me ? resource.data.members[1] : resource.data.members[0];
        let before = resource.data.get('unread', {});
        let after = request.resource.data.get('unread', {});
        let changed = after.diff(before).affectedKeys();
        return changed.hasOnly([me, peer])
               && (!(me in changed) || after[me] == 0)
               && (!(peer in changed) || after[peer] == before.get(peer, 0) + 1);
      }

      // "Has sent a message here", one flag per member: what unlocks phone
      // numbers (hasConversationWith). Only ever your own, only ever true.
      function sentChangeOk() {
        let before = resource.data.get('sent', {});
        let after = request.resource.data.get('sent', {});
        let changed = after.diff(before).affectedKeys();
        return changed.size() == 0
               || (changed.hasOnly([request.auth.uid]) && after[request.auth.uid] == true);
      }

      // Blocking: your own flag only, set to true or removed (unblock). Nobody
      // can block -- or unblock -- on the other member's behalf.
      function blockChangeOk() {
        let before = resource.data.get('blocked', {});
        let after = request.resource.data.get('blocked', {});
        let changed = after.diff(before).affectedKeys();
        return changed.size() == 0
               || (changed.hasOnly([request.auth.uid]) && after.get(request.auth.uid, true) == true);
      }

      // While either member has the other blocked, the chat goes quiet: no
      // new preview (except a delete for everyone), no bump to the top of the
      // list, no badge on the other side. Receipts, clearing your own badge
      // and the block flags themselves still move.
      function quietWhileBlocked() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        let unreadChanged = request.resource.data.get('unread', {})
                              .diff(resource.data.get('unread', {})).affectedKeys();
        return (resource.data.get('blocked', {}).size() == 0
                && request.resource.data.get('blocked', {}).size() == 0)
               || (changed.hasOnly(['lastRead', 'lastDelivered', 'unread', 'blocked', 'lastMessage'])
                   && unreadChanged.hasOnly([request.auth.uid])
                   && (!('lastMessage' in changed)
                       || request.resource.data.lastMessage.get('deleted', false) == true
                       || expiredPreviewCleared()));
      }

      // A disappearing message's preview, once it has expired, may lose its
      // ciphertext at the hands of either member -- and nothing else may
      // change about it. That way the chat doc forgets it even if the sender
      // never comes back.
      function expiredPreviewCleared() {
        let before = resource.data.get('lastMessage', null);
        let after = request.resource.data.lastMessage;
        return before != null
               && before.get('expiresAt', null) != null
               && before.expiresAt < request.time
               && after != null
               && after.keys().hasOnly(['id', 'senderId', 'expiresAt'])
               && after.get('id', null) == before.get('id', null)
               && after.senderId == before.senderId
               && after.expiresAt == before.expiresAt;
      }

      // Disappearing messages: off, 24 hours, 7 days or 90 days, in seconds.
      // Either member may set it. Keep in step with DISAPPEARING_OPTIONS.
      function disappearingOk() {
        return request.resource.data.get('disappearing', 0) in [0, 86400, 604800, 7776000];
      }

      // The list preview is a copy of the newest message's ciphertext; it gets
      // the same ceiling as the message.
      function previewSizeOk() {
        let preview = request.resource.data.get('lastMessage', null);
        return preview == null
               || preview.get('ciphertext', '').size() <= MAX_CIPHERTEXT();
      }

      // The ordering and preview fields. updatedAt only ever moves to "now"
      // (the app writes serverTimestamp()), and a new preview must be one's
      // own message. Without this a member could date a chat in the year
      // 2100 -- pinned to the top of the other's list and unread forever --
      // or plant a preview claiming to come from the other person.
      function metaChangeOk() {
        let changed = request.resource.data.diff(resource.data).affectedKeys();
        return request.resource.data.keys().hasOnly([
                 'members', 'lastMessage', 'lastRead', 'lastDelivered', 'unread', 'sent',
                 'blocked', 'disappearing', 'createdAt', 'updatedAt'])
               && !('createdAt' in changed)
               && (!('updatedAt' in changed) || request.resource.data.updatedAt == request.time)
               && (!('lastMessage' in changed)
                   || (previewShapeOk()
                       && (request.resource.data.lastMessage.senderId == request.auth.uid
                           || expiredPreviewCleared())));
      }

      // The preview's fields, each of the type the app writes. Both phones
      // parse this doc for their chat list, so a value of the wrong type --
      // a number where a timestamp belongs -- must never get in.
      function previewShapeOk() {
        let preview = request.resource.data.lastMessage;
        return preview == null
               || (preview is map
                   && preview.keys().hasOnly(['id', 'senderId', 'ciphertext', 'nonce', 'deleted', 'expiresAt'])
                   && preview.senderId is string
                   && preview.get('id', '') is string
                   && preview.get('ciphertext', '') is string
                   && preview.get('nonce', '') is string
                   && preview.get('deleted', false) is bool
                   && (preview.get('expiresAt', null) == null || preview.expiresAt is timestamp));
      }

      // lastMessage / updatedAt / receipts / unread / sent / blocked may move;
      // the member list may not.
      allow update: if isMember()
                    && request.resource.data.members == resource.data.members
                    && metaChangeOk()
                    && ownReceiptOnly('lastRead')
                    && ownReceiptOnly('lastDelivered')
                    && unreadChangeOk()
                    && sentChangeOk()
                    && blockChangeOk()
                    && quietWhileBlocked()
                    && disappearingOk()
                    && previewSizeOk();

      allow delete: if false;

      // Conversation key, sealed to one member's public key. You may read only
      // the copy addressed to you.
      match /keys/{uid} {
        allow read: if isSelf(uid);
        allow create: if signedIn() && request.auth.uid in chatMembers(chatId);
        allow update, delete: if false;
      }

      // "Delete for me": the ids of messages one member has hidden. Private to
      // that member -- the other person never learns what was hidden.
      // Each doc also names its owner in a `uid` field, which is what lets the
      // chat list fetch all of one person's hidden lists in a single
      // collection-group query (see the match at the bottom).
      match /hidden/{uid} {
        allow read: if isSelf(uid) && request.auth.uid in chatMembers(chatId);
        // clearedAt is "Clear chat" (lib/db/messages.ts clearChat): everything
        // up to it is gone for this member. Only ever the server's "now", so it
        // cannot be set back to bring cleared messages back, or forward to
        // hide ones not yet sent.
        allow create, update: if isSelf(uid)
                              && request.auth.uid in chatMembers(chatId)
                              && request.resource.data.get('uid', uid) == uid
                              && (request.resource.data.get('clearedAt', null)
                                    == (resource == null ? null : resource.data.get('clearedAt', null))
                                  || request.resource.data.get('clearedAt', null) == request.time);
        // No membership lookup: account deletion removes every list in one
        // batch, and a get() per list would exceed the rules' read budget.
        allow delete: if isSelf(uid);
      }

      // Starred messages: ids one member has starred, same shape and same
      // privacy as the "Delete for me" list above.
      match /starred/{uid} {
        allow read: if isSelf(uid) && request.auth.uid in chatMembers(chatId);
        allow create, update: if isSelf(uid)
                              && request.auth.uid in chatMembers(chatId)
                              && request.resource.data.get('uid', uid) == uid;
        allow delete: if isSelf(uid);
      }

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in chatMembers(chatId);

        // createdAt must be the server's clock: the edit window below is
        // measured from it, so a backdated or future-dated message would get
        // the wrong window.
        // Nothing new in a chat where either member has blocked the other.
        allow create: if signedIn()
                      && request.auth.uid in chatMembers(chatId)
                      && !chatBlocked(chatId)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.ciphertext is string
                      && request.resource.data.ciphertext.size() <= MAX_CIPHERTEXT()
                      && request.resource.data.nonce is string
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.get('forwarded', false) is bool
                      && expiryOk()
                      && !request.resource.data.keys().hasAny(['editedAt', 'deleted', 'deletedAt', 'reactions']);

        // A disappearing message's expiry: the sender's clock, so only checked
        // to lie ahead and within the longest timer (90 days, plus a day of
        // slack for a fast clock). Expiring sooner than the chat's timer is
        // no worse than deleting it, which the sender may do anyway.
        function expiryOk() {
          let expiresAt = request.resource.data.get('expiresAt', null);
          return expiresAt == null
                 || (expiresAt is timestamp
                     && expiresAt > request.time
                     && expiresAt < request.time + duration.value(91, 'd'));
        }

        // A reaction: a sealed emoji (see MessageDoc.reactions), or absent.
        // Sized for one emoji -- 16 UTF-16 units seal to well under 200.
        function reactionOk(reaction) {
          return reaction == null
                 || (reaction is map
                     && reaction.keys().hasOnly(['ciphertext', 'nonce'])
                     && reaction.ciphertext is string
                     && reaction.ciphertext.size() <= 200
                     && reaction.nonce is string
                     && reaction.nonce.size() <= 64);
        }

        // Three shapes of change, and a deleted message takes none of them.
        //
        // Edit (sender only): new ciphertext and nonce, within 15 minutes of
        // sending (keep in step with EDIT_WINDOW_MS in lib/db/schema.ts).
        //
        // Delete for everyone (sender only): ciphertext, nonce and reactions
        // removed outright, leaving a tombstone with nothing to decrypt.
        //
        // React (any member): your own entry in `reactions` and nothing else,
        // so nobody can put words -- or emoji -- in the other person's mouth.
        //
        // In a blocked chat only the delete is left: an edit or a reaction
        // would be a way of still sending something.
        allow update: if signedIn()
                      && request.auth.uid in chatMembers(chatId)
                      && !resource.data.get('deleted', false)
                      && (
                        (
                          !chatBlocked(chatId)
                          && resource.data.senderId == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['ciphertext', 'nonce', 'editedAt'])
                          && request.resource.data.ciphertext is string
                          && request.resource.data.ciphertext.size() <= MAX_CIPHERTEXT()
                          && request.resource.data.nonce is string
                          && request.resource.data.editedAt == request.time
                          && request.time < resource.data.createdAt + duration.value(15, 'm')
                        ) || (
                          resource.data.senderId == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['ciphertext', 'nonce', 'reactions', 'deleted', 'deletedAt'])
                          && request.resource.data.deleted == true
                          && request.resource.data.deletedAt == request.time
                          && !request.resource.data.keys().hasAny(['ciphertext', 'nonce', 'reactions'])
                        ) || (
                          !chatBlocked(chatId)
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
                          && request.resource.data.reactions is map
                          && request.resource.data.reactions
                               .diff(resource.data.get('reactions', {})).affectedKeys()
                               .hasOnly([request.auth.uid])
                          && reactionOk(request.resource.data.reactions.get(request.auth.uid, null))
                        )
                      );

        // Tombstones rather than removal, so replies and pagination survive --
        // except for a disappearing message whose time is up, which goes
        // outright. Any member may do it, so it goes even if the sender never
        // opens the app again. (Firestore TTL would do this server-side, but
        // needs billing.)
        allow delete: if signedIn()
                      && request.auth.uid in chatMembers(chatId)
                      && resource.data.get('expiresAt', null) != null
                      && resource.data.expiresAt < request.time;
      }
    }

    // The sender's sweep (sweepExpiredMessages): one query over every
    // message the caller sent, across chats. Only ever their own messages --
    // the query filters on senderId == me.
    match /{path=**}/messages/{messageId} {
      allow list: if signedIn() && resource.data.senderId == request.auth.uid;
    }

    // The chat list's one query over every "Delete for me" list the caller
    // owns, so a hidden newest message is not shown as the preview. The query
    // filters on uid == me, and each doc may only name its own owner.
    // (The doc id is unknown while a query is evaluated, so the check is on
    // the field alone; the write rules keep the field equal to the id.)
    match /{path=**}/hidden/{uid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // The same for starred lists: the Starred screen's one query.
    match /{path=**}/starred/{uid} {
      allow list: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Deliberately no rules for pushLimits, emailCodes or emailCodeLimits:
    // only the server's Admin SDK (which bypasses rules) may touch them, and
    // with no match here every client request is refused.
  }
}
