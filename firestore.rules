rules_version = '2';

// Zing security rules.
//
// These rules ARE the backend authorization layer: browsers talk straight to
// Firestore, so anything not forbidden here is public. Message bodies are
// end-to-end encrypted on-device, so even a rules mistake leaks ciphertext
// only -- but metadata still deserves protecting.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function chatMembers(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // Profiles are readable by any signed-in user: @username search and public
    // key lookup both need it. keyBackup lives here too and is safe to expose --
    // it is an Argon2id-wrapped blob, useless without the passphrase.
    match /users/{uid} {
      allow read: if signedIn();

      allow create: if isSelf(uid)
                    && request.resource.data.username is string
                    && request.resource.data.publicKey is string;

      // Username and public key are identity anchors -- neither may drift after
      // creation, or safety numbers and @handles stop meaning anything.
      allow update: if isSelf(uid)
                    && request.resource.data.username == resource.data.username
                    && request.resource.data.publicKey == resource.data.publicKey;

      allow delete: if false;
    }

    // Username claims. Create-only, so a claim can never be stolen or reassigned.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    match /chats/{chatId} {

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      // `list` is safe because the only query the app issues is constrained by
      // array-contains on the caller's own uid.
      allow get, list: if isMember();

      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2;

      // lastMessage / updatedAt / lastRead may move; the member list may not.
      allow update: if isMember()
                    && request.resource.data.members == resource.data.members;

      allow delete: if false;

      // Conversation key, sealed to one member's public key. You may read only
      // the copy addressed to you.
      match /keys/{uid} {
        allow read: if isSelf(uid);
        allow create: if signedIn() && request.auth.uid in chatMembers(chatId);
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in chatMembers(chatId);

        allow create: if signedIn()
                      && request.auth.uid in chatMembers(chatId)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.ciphertext is string
                      && request.resource.data.nonce is string;

        // No edit or delete in v1 -- history is append-only.
        allow update, delete: if false;
      }
    }
  }
}
