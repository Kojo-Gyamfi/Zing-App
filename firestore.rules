rules_version = '2';

// Zing security rules.
//
// These rules ARE the backend authorization layer: browsers talk straight to
// Firestore, so anything not forbidden here is public. Message bodies are
// end-to-end encrypted on-device, so even a rules mistake leaks ciphertext
// only -- but metadata still deserves protecting.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // True when the caller and `uid` have a direct chat. Chat ids are the two
    // uids sorted and joined (enforced on create), so this is one lookup.
    function sharesChatWith(uid) {
      let me = request.auth.uid;
      let chatId = me < uid ? me + '_' + uid : uid + '_' + me;
      return signedIn() && exists(/databases/$(database)/documents/chats/$(chatId));
    }

    function chatMembers(chatId) {
      return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
    }

    // Profiles are readable one at a time by any signed-in user: @username
    // search and public key lookup both need it. keyBackup lives here too and
    // is safe to expose -- it is an Argon2id-wrapped blob, useless without the
    // passphrase. Listing is off: nobody needs to enumerate every user.
    //
    // Nothing private may live on this doc. The field allowlists below are what
    // keep it that way; push tokens go in private/account, the phone number in
    // shared/contact.
    match /users/{uid} {
      allow get: if signedIn();
      allow list: if false;

      // The profile and its username claim must land in the same transaction:
      // getAfter() sees the claim only if it is written alongside, and it must
      // name this user. Without this, a hand-rolled client could skip the claim
      // and put someone else's @handle on its own profile.
      allow create: if isSelf(uid)
                    && request.resource.data.keys().hasOnly([
                         'uid', 'username', 'displayName', 'photoURL', 'about',
                         'publicKey', 'keyBackup', 'createdAt'])
                    && request.resource.data.uid == uid
                    && request.resource.data.username is string
                    && request.resource.data.publicKey is string
                    && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == uid;

      // Username and public key are identity anchors -- neither may drift after
      // creation, or safety numbers and @handles stop meaning anything. Only
      // these fields may change at all.
      //
      // phone and pushTokens may only be touched to remove them: early
      // accounts stored both here, where anyone signed in could read them, and
      // migrateLegacyContact moves them out.
      allow update: if isSelf(uid)
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['displayName', 'about', 'photoURL', 'keyBackup', 'phone', 'pushTokens'])
                    && (
                      !request.resource.data.diff(resource.data).affectedKeys().hasAny(['phone', 'pushTokens'])
                      || !request.resource.data.keys().hasAny(['phone', 'pushTokens'])
                    );

      allow delete: if false;

      // Owner-only: push tokens and the recovery-key backup (plus a phone
      // number on a few early accounts, moved out on their next save). The push route reads this with admin
      // credentials, which bypass rules.
      match /private/{docId} {
        allow read, write: if isSelf(uid);
      }

      // The phone number: shown on the profile of someone you already chat
      // with, never to arbitrary signed-in users.
      //
      // The contact doc may show only a number its owner has claimed, so
      // nobody can display a number that belongs to someone else. getAfter()
      // sees a claim written in the same transaction.
      match /shared/{docId} {
        allow read: if isSelf(uid) || sharesChatWith(uid);
        allow delete: if isSelf(uid);
        allow create, update: if isSelf(uid)
                              && (docId != 'contact'
                                  || request.resource.data.get('phone', null) == null
                                  || (request.resource.data.phone is string
                                      && request.resource.data.phone.matches('^[+][1-9][0-9]{6,14}$')
                                      && getAfter(/databases/$(database)/documents/phones/$(request.resource.data.phone)).data.uid == uid));
      }
    }

    // Username claims. Create-only, so a claim can never be stolen or reassigned.
    // Each claim must be matched by the claimant's own profile in the same
    // transaction, so one account cannot squat a pile of handles.
    match /usernames/{username} {
      allow read: if signedIn();
      allow create: if signedIn()
                    && request.resource.data.uid == request.auth.uid
                    && username.matches('^[a-z0-9_]{3,20}$')
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
      allow update, delete: if false;
    }

    // Phone number claims, for "find by phone". get works for someone who
    // already knows the number; list does not, so the set cannot be dumped.
    // A claim must match the number in the claimant's own contact doc, so each
    // account holds at most one. Ids are E.164 (+233241234567), the one form
    // lib/phone.ts writes, so a number cannot be claimed twice under two
    // spellings.
    match /phones/{phone} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
                    && phone.matches('^[+][1-9][0-9]{6,14}$')
                    && request.resource.data.uid == request.auth.uid
                    && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)/shared/contact).data.phone == phone;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if false;
    }

    match /chats/{chatId} {

      function isMember() {
        return signedIn() && request.auth.uid in resource.data.members;
      }

      // `list` is safe because the only query the app issues is constrained by
      // array-contains on the caller's own uid.
      allow list: if isMember();

      // ensureDirectChat reads the doc before creating it, so a get must also
      // succeed when nothing is there yet -- resource is null then, and
      // isMember() alone would deny. Chat ids are the two uids sorted and
      // joined, so only the two people it would belong to may probe for it.
      allow get: if isMember()
                 || (signedIn() && resource == null && request.auth.uid in chatId.split('_'));

      // The id must be the members' sorted uids, so a pair can never get a
      // second conversation under some other id.
      allow create: if signedIn()
                    && request.auth.uid in request.resource.data.members
                    && request.resource.data.members.size() == 2
                    && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1];

      // A member may write only their own receipt, and only as "now" -- the app
      // always writes serverTimestamp(). Without this either member could mark
      // the other as having read or received messages they never saw.
      function ownReceiptOnly(field) {
        let before = resource.data.get(field, {});
        let after = request.resource.data.get(field, {});
        let changed = after.diff(before).affectedKeys();
        return changed.size() == 0
               || (changed.hasOnly([request.auth.uid]) && after[request.auth.uid] == request.time);
      }

      // Unread badges: I may clear my own count, or add exactly one to the
      // other member's when I send. Nothing else -- no inflating someone's
      // badge by a thousand, no zeroing it for them.
      function unreadChangeOk() {
        let me = request.auth.uid;
        let peer = resource.data.members[0] == me ? resource.data.members[1] : resource.data.members[0];
        let before = resource.data.get('unread', {});
        let after = request.resource.data.get('unread', {});
        let changed = after.diff(before).affectedKeys();
        return changed.hasOnly([me, peer])
               && (!(me in changed) || after[me] == 0)
               && (!(peer in changed) || after[peer] == before.get(peer, 0) + 1);
      }

      // lastMessage / updatedAt / receipts / unread may move; the member list may not.
      allow update: if isMember()
                    && request.resource.data.members == resource.data.members
                    && ownReceiptOnly('lastRead')
                    && ownReceiptOnly('lastDelivered')
                    && unreadChangeOk();

      allow delete: if false;

      // Conversation key, sealed to one member's public key. You may read only
      // the copy addressed to you.
      match /keys/{uid} {
        allow read: if isSelf(uid);
        allow create: if signedIn() && request.auth.uid in chatMembers(chatId);
        allow update, delete: if false;
      }

      // "Delete for me": the ids of messages one member has hidden. Private to
      // that member -- the other person never learns what was hidden.
      match /hidden/{uid} {
        allow read, write: if isSelf(uid) && request.auth.uid in chatMembers(chatId);
      }

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in chatMembers(chatId);

        // createdAt must be the server's clock: the edit window below is
        // measured from it, so a backdated or future-dated message would get
        // the wrong window.
        allow create: if signedIn()
                      && request.auth.uid in chatMembers(chatId)
                      && request.resource.data.senderId == request.auth.uid
                      && request.resource.data.ciphertext is string
                      && request.resource.data.nonce is string
                      && request.resource.data.createdAt == request.time
                      && !request.resource.data.keys().hasAny(['editedAt', 'deleted', 'deletedAt']);

        // Only the sender may change a message, and only in two shapes. A
        // deleted message is final.
        //
        // Edit: new ciphertext and nonce, within 15 minutes of sending (keep in
        // step with EDIT_WINDOW_MS in lib/db/schema.ts).
        //
        // Delete for everyone: ciphertext and nonce removed outright, leaving a
        // tombstone with nothing to decrypt.
        allow update: if signedIn()
                      && resource.data.senderId == request.auth.uid
                      && request.auth.uid in chatMembers(chatId)
                      && !resource.data.get('deleted', false)
                      && (
                        (
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['ciphertext', 'nonce', 'editedAt'])
                          && request.resource.data.ciphertext is string
                          && request.resource.data.nonce is string
                          && request.resource.data.editedAt == request.time
                          && request.time < resource.data.createdAt + duration.value(15, 'm')
                        ) || (
                          request.resource.data.diff(resource.data).affectedKeys()
                            .hasOnly(['ciphertext', 'nonce', 'deleted', 'deletedAt'])
                          && request.resource.data.deleted == true
                          && request.resource.data.deletedAt == request.time
                          && !request.resource.data.keys().hasAny(['ciphertext', 'nonce'])
                        )
                      );

        // Tombstones rather than removal, so replies and pagination survive.
        allow delete: if false;
      }
    }
  }
}
