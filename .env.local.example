# Template only — no real values here. Copy to .env.local, or run `npm run setup`.
#
# Firebase web app config (Project settings -> General -> Your apps -> Web).
# These are PUBLIC by design: they identify the project, they do not authorize
# anything. Security rules do the authorizing, and message bodies are encrypted
# on the device regardless. They ship in the JS bundle either way.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Realtime Database URL — used for typing and presence only.
# Must be the europe-west1 instance:
#   https://<project>-default-rtdb.europe-west1.firebasedatabase.app
NEXT_PUBLIC_FIREBASE_DATABASE_URL=

# Web Push certificate key pair
# (Project settings -> Cloud Messaging -> Web configuration).
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---- Server only. Never prefix these with NEXT_PUBLIC_. ----
# Service account JSON on a single line, wrapped in single quotes, for sending
# push from the API route. In Vercel, paste the raw JSON with no quotes.
FIREBASE_SERVICE_ACCOUNT=

# Email sign-in codes, sent from Zing's own Gmail account (e.g. zing.signin@gmail.com).
# The password is a Google "App password" (account -> Security -> 2-Step
# Verification -> App passwords), not the account's real password.
GMAIL_SMTP_USER=
GMAIL_SMTP_APP_PASSWORD=
# Random secret the codes are hashed with. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
EMAIL_CODE_SECRET=

# ---- Optional ----
# Firebase App Check with reCAPTCHA v3 (App Check -> Apps -> Register -> reCAPTCHA).
# Leave empty to run without App Check. After setting it, turn on enforcement
# for Firestore, Realtime Database and Authentication in the Firebase Console.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# Sentry error monitoring (sentry.io -> project -> Client Keys (DSN)). Leave
# empty to disable. Only errors are sent: no breadcrumbs, inputs or user data.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
